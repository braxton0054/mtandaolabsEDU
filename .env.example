# ─────────────────────────────────────────────────────────────────────────────
# mtandaolabsEDU — Environment Configuration (example only — DO NOT COMMIT REAL VALUES)
# Copy to .env.local for local development and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=mtandaolabsEDU
APP_VERSION=0.1.0
APP_URL=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Pretty-print logs in dev only. Production uses structured JSON.
LOG_PRETTY=false

# ─── API ──────────────────────────────────────────────────────────────────────
# Public base path for the versioned API. /api/v1/...
API_PREFIX=/api
API_VERSION=v1

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev/staging/prod URLs differ. Use connection pooling URLs in serverless envs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mtandaolabsedu_dev
# In serverless/prod, point DIRECT_URL to the underlying instance (no pooler).
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mtandaolabsedu_dev
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=mtandaolabsedu

# ─── Rate limiting (defaults; tuned per-route later) ──────────────────────────
RATE_LIMIT_DEFAULT_WINDOW_SEC=60
RATE_LIMIT_DEFAULT_MAX=120

# ─── Security ────────────────────────────────────────────────────────────────
# 32+ char secret used to sign session cookies / CSRF tokens (Phase 2).
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-long-random-secret-min-32-chars
# Trusted origins for CSRF / CORS (comma-separated).
TRUSTED_ORIGINS=http://localhost:3000

# ─── File storage (VPS local for Phase 1; swappable later) ───────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# ─── Backup (Backblaze B2 — Phase 1 placeholders only) ────────────────────────
BACKUP_DRIVER=local
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
BACKUP_B2_BUCKET=
BACKUP_B2_ENDPOINT=

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=